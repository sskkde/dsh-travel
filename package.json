{
  "name": "dsh-travel",
  "version": "0.0.1",
  "description": "旅行规划插件（hybrid：node 工具 + client 设置页预留）——一句话需求 → 追问 ≤3 轮 → 三 research → build → render → 可交互 Leaflet 行程页",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-rc.1 <0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <0.2",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-util-values": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-web": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0",
    "schemastery": "^3.18.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.1 <0.2",
    "@deepseek-ai/dsh-client-modules": ">=0.1.7-rc.1 <0.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.1 <0.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1 <0.2",
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "build:client": "tsdown",
    "test": "vitest run",
    "test:e2e:settings-collapse": "npm run build && npm run build:client && bash scripts/run-settings-collapse-e2e.sh",
    "test:e2e": "npm run test:e2e:settings-collapse"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
